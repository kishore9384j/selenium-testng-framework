<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Smoke Suite" verbose="1">

    <listeners>
        <listener class-name="com.saucedemo.automation.listeners.TestListener"/>
    </listeners>

    <parameter name="browser"  value="chrome"/>
    <parameter name="headless" value="false"/>

    <!-- Smoke = only the most critical test -->
    <test name="Smoke - E2E Checkout">
        <classes>
            <class name="com.saucedemo.automation.tests.E2ECheckoutTest">
                <methods>
                    <include name="testCompleteCheckoutFlow"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>